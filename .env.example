# Accounts: read-only JSON database from the netflix-clone project.
NETFLIX_DB_PATH=C:/Users/HungTaPhi/GroupCalendarCompanion/data/db.json

# This service's own database + sessions.
MUSIC_DB_PATH=C:/Users/HungTaPhi/GroupCalendarMedia/data/music.db
SESSION_TTL_DAYS=30

# Eclipse Music add-ons for FLAC playback (Stream-Bridge style, tried in order).
# Paste the personal add-on URL, with or without /manifest.json.
ECLIPSE_ADDON_URLS=
ECLIPSE_QUALITY=HI_RES_LOSSLESS
ECLIPSE_DURATION_TOLERANCE_S=8

# Last.fm application credentials (https://www.last.fm/api/account/create).
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_CALLBACK_URL=http://127.0.0.1:8089/api/v1/lastfm/callback
LASTFM_RETURN_URL=http://127.0.0.1:5180/profile

CORS_ORIGINS=*
YT_COUNTRY=VN
YT_FORMAT=opus
